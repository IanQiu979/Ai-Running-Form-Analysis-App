{
  "name": "v2.3-photo-video-analysis",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "assets": "node ./scripts/generate-app-assets.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "npm run generate:routes && tsc --noEmit && npm run typecheck:edge",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions",
    "generate:routes": "expo customize tsconfig.json",
    "test": "jest --runInBand && npm run test:edge",
    "test:edge": "npm run verify:knowledge && deno test --config supabase/functions/deno.json --allow-read --allow-env=SUPABASE_PUBLISHABLE_KEYS,SUPABASE_SECRET_KEYS,SUPABASE_URL supabase/functions",
    "test:edge:local": "bash scripts/test-edge-local.sh",
    "test:canary": "jest --config jest.canary.config.js",
    "eval:grounding": "deno run --config supabase/functions/deno.json --env-file=supabase/functions/.env --allow-env=ANTHROPIC_API_KEY,GITHUB_SHA --allow-net=api.anthropic.com --allow-write=supabase/functions/_shared/evals supabase/functions/_shared/evals/grounding-eval.live.ts",
    "generate:knowledge": "node ./scripts/generate-knowledge-bundle.js",
    "verify:knowledge": "npm run generate:knowledge && git diff --exit-code -- supabase/functions/_shared/knowledge.generated.ts"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.2",
    "aes-js": "^3.1.2",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "sharp": "^0.35.3",
    "test-renderer": "1.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
}

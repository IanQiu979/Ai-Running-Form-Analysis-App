{
  "name": "v2.3-photo-video-analysis",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "assets": "node ./scripts/generate-app-assets.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "npm run generate:routes && tsc --noEmit && npm run typecheck:edge",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions",
    "generate:routes": "expo customize tsconfig.json",
    "test": "jest --runInBand && npm run test:edge",
    "test:edge": "npm run verify:knowledge && deno test --config supabase/functions/deno.json --allow-read --allow-env=SUPABASE_PUBLISHABLE_KEYS,SUPABASE_SECRET_KEYS,SUPABASE_URL supabase/functions",
    "test:edge:local": "bash scripts/test-edge-local.sh",
    "test:canary": "jest --config jest.canary.config.js",
    "eval:grounding": "deno run --config supabase/functions/deno.json --env-file=supabase/functions/.env --allow-env=ANTHROPIC_API_KEY,GITHUB_SHA --allow-net=api.anthropic.com --allow-write=supabase/functions/_shared/evals supabase/functions/_shared/evals/grounding-eval.live.ts",
    "generate:knowledge": "node ./scripts/generate-knowledge-bundle.js",
    "verify:knowledge": "npm run generate:knowledge && git diff --exit-code -- supabase/functions/_shared/knowledge.generated.ts"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.110.2",
    "aes-js": "^3.1.2",
    "expo": "^56.0.0",
    "expo-auth-session": "~56.0.18",
    "expo-blur": "~56.0.4",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.25",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.26",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-router": "~56.2.20",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-video-thumbnails": "~56.0.3",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "sharp": "^0.35.3",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}

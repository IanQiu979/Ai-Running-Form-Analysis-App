# Committed template. Copy to .env and fill in real values.
# Only public, bundle-safe identifiers belong here — EXPO_PUBLIC_* is inlined
# into the compiled app in plain text.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (issue #12/Known Issue #12) — public by Cloudflare's own design,
# safe to inline client-side; only the SECRET key (server-side, supabase/functions/.env, never
# here) actually verifies anything. The real production key lives outside this repo (EAS
# environment variables), same as production's EXPO_PUBLIC_SUPABASE_URL above.
# LEAVING THIS EMPTY DISABLES EMAIL SIGN-UP ENTIRELY — the screen degrades to a visible
# "creating an account isn't available" notice with the button disabled, which is what shipped
# for the whole of #166's life. It is not a warning-free default.
# For local testing against the local Supabase stack (`supabase start`), use Cloudflare's public,
# documented "always passes" test key instead of the real one:
#   EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# The hostname the Turnstile challenge is rendered under, and the SECOND HALF of the site key —
# a key without a matching hostname cannot work. Turnstile widgets are hostname-bound (Cloudflare
# requires at least one hostname per widget and offers no way to disable the check), so whatever
# goes here MUST also appear in that widget's hostname list in the Cloudflare dashboard, or every
# challenge fails with error 110200 no matter how correct the key is.
# Leave it EMPTY to use the Supabase project's own hostname (derived from
# EXPO_PUBLIC_SUPABASE_URL above) — then just add that host to the widget in Cloudflare and
# nothing else is needed. Set it only if the widget is registered against a different domain.
# Accepts a bare hostname (`example.com`) or a full origin (`https://example.com`).
# Cloudflare's dummy test keys ignore hostnames entirely, so this is irrelevant for local dev.
EXPO_PUBLIC_TURNSTILE_HOSTNAME=

# Google / Apple OAuth credentials are NOT configured here. They are set in the
# Supabase dashboard under Authentication > Sign In / Providers, because this app
# uses the browser-based OAuth flow where the provider talks to Supabase directly.

# Secrets (ANTHROPIC_API_KEY, service-role key, Turnstile's SECRET key) are NOT configured
# here. They live in the edge function env: `supabase secrets set ANTHROPIC_API_KEY=...` /
# `supabase secrets set TURNSTILE_SECRET_KEY=...`
